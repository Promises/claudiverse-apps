<?xml version="1.0" encoding="utf-8"?>
<!--
  The Claudiverse Android app. Its OpenVPN tunnel (the :openvpn module)
  carries only this app's own traffic and is controlled only from inside it.
  -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Self-update: installs builds downloaded from the Claudiverse server. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The watcher's "Allow background use" asks for an exemption directly. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="@string/claudiverse_app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:appCategory="productivity"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/claudiverse_network_security"
        tools:ignore="GoogleAppIndexingWarning,UnusedAttribute">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Claudiverse"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Listens for seats that ask for the operator while the app is closed. -->
        <service
            android:name=".watch.WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="operator-requests" />
        </service>

        <!-- After an update: bring the VPN check and the watcher back up. -->
        <receiver android:name=".update.UpdatedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The package installer's answer to a self-update. -->
        <receiver android:name=".update.UpdateStatusReceiver" android:exported="false" />
    </application>

</manifest>
