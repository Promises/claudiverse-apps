<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background: the full 108dp adaptive canvas in brand violet.
  A vector, not a bare @color: the Claude app's icon is built this way, and the
  Niagara launcher drew this app's colour-backed icon as a circle on a white
  plate while it renders drawable-backed ones (Claude, Car Scanner) full-bleed.
  -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z" android:fillColor="@color/claudiverse_brand" />
</vector>
