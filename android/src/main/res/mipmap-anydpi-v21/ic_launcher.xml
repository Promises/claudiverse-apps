<?xml version="1.0" encoding="utf-8"?>
<!-- Android 5-7, which has no adaptive icons: the same two layers, on a rounded square. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/claudiverse_brand" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_claudiverse_mark" />
</layer-list>
